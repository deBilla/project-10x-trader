# --- Alpaca (paper trading) ---
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_PAPER_TRADE=true

# --- Anthropic (Claude Agent SDK) ---
ANTHROPIC_API_KEY=your_anthropic_key_here
# Model used for the trading reasoning loop
TRADER_MODEL=claude-opus-4-8

# --- Persistence ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB=trader
REDIS_URL=redis://redis:6379/0

# --- Config file locations (defaults work inside the container) ---
TRADER_CONFIG_DIR=./config

# --- Runtime ---
# Set to true to run a single tick and exit (smoke test / dry run)
TRADER_RUN_ONCE=false
# Set to true to skip live order placement entirely (planning only)
TRADER_DRY_RUN=false
